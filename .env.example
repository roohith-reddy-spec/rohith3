# Local development values
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/kayden
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

